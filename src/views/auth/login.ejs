  <h1 class="login-title">Herbario Llanos</h1>

  <details class="login-access">
    <summary class="login-access-toggle" aria-label="Iniciar sesión">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="4"></circle>
        <path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
      </svg>
    </summary>
    <div class="login-access-panel">
      <h2>Iniciar sesión</h2>
      <form method="post" action="/login">
        <div class="field">
          <label for="login-username">Usuario o correo</label>
          <input id="login-username" type="text" name="username" required autofocus>
        </div>
        <div class="field">
          <label for="login-password">Contraseña</label>
          <input id="login-password" type="password" name="password" required>
        </div>
        <button type="submit">Entrar</button>
      </form>
      <p class="hint">¿Eres estudiante y no tienes cuenta? <a href="/register">Regístrate con tu correo @unillanos.edu.co</a></p>
    </div>
  </details>

  <footer class="login-contact">
    <a href="https://soluctiasas.com" target="_blank" rel="noopener">soluctiasas.com</a>
    <span class="sep">&middot;</span>
    <a href="mailto:contacto@soluctiasas.com">contacto@soluctiasas.com</a>
    <span class="sep">&middot;</span>
