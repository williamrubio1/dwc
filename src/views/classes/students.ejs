<%- include('../partials/header', { title: 'Estudiantes vinculados' }) %>
<h1>Estudiantes vinculados &mdash; <%= clase.nombre_clase %></h1>
<div class="card">
  <form method="get" style="display:flex;gap:0.5rem;">
    <input type="text" name="email" value="<%= email %>" placeholder="Buscar por correo institucional">
    <button type="submit">Buscar</button>
  </form>
</div>
<div class="card">
<table>
  <thead><tr><th>Nombre</th><th>Correo</th><th>Programa</th><th>Semestre</th><th>Código estudiantil</th></tr></thead>
  <tbody>
  <% students.forEach(function(s) { %>
    <tr><td><%= s.nombre %></td><td><%= s.email %></td><td><%= s.programa || '-' %></td><td><%= s.semestre || '-' %></td><td><%= s.codigo_estudiantil || '-' %></td></tr>
  <% }); %>
  <% if (students.length === 0) { %><tr><td colspan="5">Sin estudiantes vinculados.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>
