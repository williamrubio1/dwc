<%- include('../partials/header', { title: 'Registros de la clase' }) %>
<h1>Registros &mdash; <%= clase.nombre_clase %></h1>

<div class="card">
<form class="stack" method="get" style="flex-direction:row;flex-wrap:wrap;align-items:end;">
  <div class="field"><label>Creado desde</label><input type="date" name="fechaCreacionDesde" value="<%= query.fechaCreacionDesde || '' %>"></div>
  <div class="field"><label>Creado hasta</label><input type="date" name="fechaCreacionHasta" value="<%= query.fechaCreacionHasta || '' %>"></div>
  <div class="field"><label>Modificado desde</label><input type="date" name="fechaModDesde" value="<%= query.fechaModDesde || '' %>"></div>
  <div class="field"><label>Modificado hasta</label><input type="date" name="fechaModHasta" value="<%= query.fechaModHasta || '' %>"></div>
  <div class="field"><label>recordNumber</label><input type="text" name="recordNumber" value="<%= query.recordNumber || '' %>"></div>
  <button type="submit">Filtrar</button>
</form>
</div>

<div class="card">
<table>
  <thead><tr><th>occurrenceID</th><th>Estudiante</th><th>Científico</th><th>recordNumber</th><th>Fecha</th><th>Estado</th><th></th></tr></thead>
  <tbody>
  <% records.forEach(function(r) { %>
    <tr>
      <td><%= r.occurrenceID %></td>
      <td><%= r.estudiante %></td>
      <td><em><%= r.scientificName || '' %></em></td>
      <td><%= r.recordNumber || '' %></td>
      <td><%= r.eventDate || '' %></td>
      <td><span class="badge <%= r.estado_validacion %>"><%= r.estado_validacion.replace('_',' ') %></span></td>
      <td><a href="/classes/<%= clase.id %>/records/<%= r.id %>">Ver</a></td>
    </tr>
  <% }); %>
  <% if (records.length === 0) { %><tr><td colspan="7">No hay registros con estos filtros.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>
