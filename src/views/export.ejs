<%- include('partials/header', { title: 'Exportar' }) %>
<h1>Exportar registros</h1>
<div class="card">
<form class="stack" method="get" action="/export/download" style="max-width:none;flex-direction:row;flex-wrap:wrap;align-items:end;">
  <div class="field"><label>Formato</label>
    <select name="formato"><option value="csv">CSV</option><option value="xlsx">XLSX</option></select>
  </div>
  <div class="field"><label>Creado desde <span class="helpball" title="Opcional. Filtra por la fecha en que se creó el registro en el sistema (no la fecha de colecta). Déjelo vacío para no limitar por fecha inicial.">ⓘ</span></label><input type="date" name="fechaDesde"></div>
  <div class="field"><label>Creado hasta <span class="helpball" title="Opcional. Déjelo vacío para no limitar por fecha final.">ⓘ</span></label><input type="date" name="fechaHasta"></div>
  <div class="field"><label>recordNumber <span class="helpball" title="Opcional, sin formato fijo: busca coincidencia parcial dentro del campo recordNumber de cada registro. Si lo deja vacío, se exportan todos los registros (filtrados solo por fecha, si puso alguna).">ⓘ</span></label><input type="text" name="recordNumber" placeholder="Opcional"></div>
  <% if (role !== 'estudiante') { %>
  <div class="field"><label>Clase</label>
    <select name="claseId">
      <option value="">Todas</option>
      <% clasesDisponibles.forEach(function(c){ %><option value="<%= c.id %>"><%= c.nombre_clase %></option><% }); %>
    </select>
  </div>
  <div class="field"><label>Correo del estudiante</label><input type="text" name="estudianteEmail"></div>
  <% } %>
  <button type="submit">Descargar</button>
</form>
</div>
<%- include('partials/footer') %>
