<%- include('../partials/header', { title: 'Mis registros' }) %>
<h1>Mis registros</h1>
<p class="actions">
  <a class="btn" href="/records/new">+ Nuevo registro</a>
  <a class="btn secondary" href="/import">Importar CSV/XLSX</a>
  <a class="btn secondary" href="/export">Exportar</a>
  <a class="btn secondary" href="/plantilla-descargable">Descargar plantilla</a>
</p>

<div class="legend">
  <span class="item"><span class="badge incompleto">Incompleto</span> falta algún campo que imprime el sobre</span>
  <span class="item"><span class="badge con_advertencias">Con advertencias</span> tiene los campos del sobre pero con inconsistencias</span>
  <span class="item"><span class="badge completo_para_sobre">Completo para sobre</span> listo para generar el sobre</span>
</div>

<div class="card">
<form method="post" action="/records/bulk-delete" data-bulk>
<% if (records.length > 0) { %>
<div class="bulkbar">
  <button type="submit" class="btn danger" data-bulk-submit disabled>Eliminar seleccionados</button>
  <span class="hint" data-bulk-count></span>
  <span class="hint">Marque los registros a eliminar; antes de borrar se le pedirá confirmación.</span>
</div>
<% } %>
<table>
  <thead><tr>
    <th class="check"><% if (records.length > 0) { %><input type="checkbox" data-bulk-all aria-label="Seleccionar todos"><% } %></th>
    <th>occurrenceID</th><th>Epíteto / género</th><th>Familia</th><th>Fecha</th><th>Estado</th><th>Versión</th><th></th>
  </tr></thead>
  <tbody>
  <% records.forEach(function(r) { %>
    <tr>
      <td class="check"><input type="checkbox" name="ids" value="<%= r.id %>" data-bulk-item aria-label="Seleccionar <%= r.occurrenceID %>"></td>
      <td><%= r.occurrenceID %></td>
      <td><em><%= r.specificEpithet || r.genus || r.scientificName || '' %></em></td>
      <td><%= r.family || '' %></td>
      <td><%= r.eventDate || '' %></td>
      <td><span class="badge <%= r.estado_validacion %>"><%= r.estado_validacion.replace('_',' ') %></span></td>
      <td><%= r.version %></td>
      <td class="actions">
        <a href="/records/<%= r.id %>/edit">Editar</a>
        <a href="/records/<%= r.id %>/history">Historial</a>
        <a href="/records/<%= r.id %>/envelope/preview" target="_blank">Vista previa sobre</a>
        <a href="/records/<%= r.id %>/delete">Eliminar</a>
      </td>
    </tr>
  <% }); %>
  <% if (records.length === 0) { %><tr><td colspan="8">Aún no tiene registros.</td></tr><% } %>
  </tbody>
</table>
</form>
</div>
<script src="/js/bulk-select.js" defer></script>
<%- include('../partials/footer') %>
